# Credenciais core pertencem ao Access Guardian; estes valores sao apelidos.
# Cadastre a identidade correspondente no cofre antes de usar este exemplo.
# Robo de REMESSA CNAB — exemplo de configuracao.
# Copie para config/robo_remessa.env (que e gitignored) e preencha.
#
#   cp config/robo_remessa.example.env config/robo_remessa.env
#   chmod 600 config/robo_remessa.env

# --- credenciais do Smart -------------------------------------------------- #
# ATENCAO: o usuario precisa de acesso as telas Financeiro > CNAB (Gerar Remessa
# e Download de Remessa) E as contas que serao percorridas. NAO e o mesmo perfil
# dos boletos (envioboletos) nem necessariamente o do doc2you (Raphaelas).
#
# ATENCAO 2 — JANELA DE HORARIO: o Smart so aceita o login dentro do horario de
# acesso cadastrado no usuario. Se o robo roda as 18:00, a janela dele tem de
# cobrir as 18:00, senao o dologin.php responde "Usuario com acesso restrito."
# e o login falha sem ser culpa do CapSolver.
REMESSA_EMAIL=
REMESSA_SENHA=GSMARTPWD1

# --- seguranca ------------------------------------------------------------- #
# DRY_RUN_REM=True  -> monta o POST, loga o que faria, NAO gera nada (default)
# DRY_RUN_REM=false -> GERA DE VERDADE no Smart (consome sequencial e tira
#                      titulo da fila; nao e reversivel)
DRY_RUN_REM=True

# --- escopo ---------------------------------------------------------------- #
# Prefixo das contas percorridas por --todas-contas.
# PREFIXO_CONTAS_REM=mp
# Carteira usada na geracao (se a conta nao tiver, o robo cai na 1a valida dela).
# CARTEIRA_REMESSA=9

# --- destino --------------------------------------------------------------- #
# Bind-mount do host declarado no docker-compose.yml:
#   /home/prospere/docker/automation/process-automation/tmp/remessas a enviar
# PASTA_REMESSAS=/app/data/remessas_a_enviar
# ARQ_CONTROLE=/app/data/robo_remessa/controle_remessas.csv

# --- ambiente (so mexa se souber por que) ---------------------------------- #
# USER_DATA_DIR_REM=/app/data/robo_remessa/perfil_chrome
# CDP_PORT_REM=9224          # 9222=boletos, 9223=doc2you, 9224=remessa
# HEADLESS_REM=False         # False: pinta no Xvfb :97 (da p/ ver pelo VNC)
# DIALOGOS=aceitar           # recusar = nunca confirma geracao pela tela
