# Credenciais core pertencem ao Access Guardian; estes valores sao apelidos.
# Cadastre a identidade correspondente no cofre antes de usar este exemplo.
# =============================================================================
# Robô de FINALIZAR OPERAÇÃO — credenciais e ajustes
# Copie para config/finalizar_operacao.env (modo 600). O .env real é gitignored;
# este exemplo é versionado. NUNCA preencha valores aqui.
# =============================================================================

# --- Smart Securities --------------------------------------------------------
# ⚠️ É ESTA conta que aparece na trilha do Smart como QUEM FINALIZOU a operação.
# Escolha com isso em mente: se for o login de uma pessoa, toda finalização
# automática vai parecer feita por ela.
SMART_EMAIL=
SMART_SENHA=GSMARTPWD3

# --- Sessão / navegador ------------------------------------------------------
# Slot reservado deste robô (docs/COMO_SUBIR_UM_JOB.md §1). NÃO compartilhe
# display nem perfil com outro robô: dois Chromes no mesmo display fazem o
# login quicar de volta para a landing, e dois no mesmo user-data-dir disputam
# o lock — um simplesmente não sobe.
DISPLAY_R7=:92
CDP_PORT_R7=9228
USER_DATA_DIR_R7=/app/data/robo_finalizar/perfil_chrome
HEADLESS_R7=False

# --- Banco (opcional) --------------------------------------------------------
# Só ENRIQUECE o relatório com cedente/valor. O robô funciona sem ele — sem
# banco o `cedente` sai vazio e quem identifica o recebedor é o `favorecido`,
# lido da própria grade de pagamento.
# DB_HOST / DB_USER / DB_PASSWORD vêm do .env da raiz via env_file.

# --- Operação ----------------------------------------------------------------
# ⚠️ DRY_RUN=1 confere e avisa mas NÃO finaliza. SUBA ASSIM.
# Armadilha 2 do guia: DRY no .env + task sem a flag = execução com exit=0 e
# resumo bonito, sem ter feito nada. Confira o valor efetivo DEPOIS de escrever
# este arquivo.
R7_DRY_RUN=1
R7_INTERVALO_CICLO_S=300
R7_ETAPA_ENTRADA=15
R7_ROTULO_ETAPA_ENTRADA="Aguardando Ass."

# --- Regras da forma de pagamento -------------------------------------------
R7_TIPO_PAGAMENTO=PIX
R7_CONTA_ORIGEM="mp prospere"
R7_CAMPOS_OBRIGATORIOS=cta_destino,bco,agencia,tipo_conta,cc,favorecido,cpf_cnpj
R7_EXIGIR_CHAVE_PIX=1
R7_EXIGIR_VENCTO_HOJE=1
R7_EXIGIR_SP=1
# Pagamento só é conferido DEPOIS que as assinaturas passam (0 = confere sempre)
R7_PAGAMENTO_SO_APOS_ASSINATURAS=1

# --- Regras dos documentos (doc2you) ----------------------------------------
R7_TIPOS_COM_DUPLICATA=DUR,DSR,DMR
R7_TIPOS_LCB=LCB
# A Prosper é reconhecida pelo PAPEL, não pelo nome — um cedente "PROSPERIDADE"
# não pode ser confundido com ela.
R7_PAPEIS_PROSPER=Contratada
R7_PAPEIS_TERCEIRO=Contratante,Avalista,Interveniente,Testemunha
R7_CNPJ_PROSPER=

# --- Avisos ------------------------------------------------------------------
R7_EMAIL_ATIVO=0
R7_EMAIL_DESTINO=operacional@prospereinvest.com.br

# WhatsApp: dentro do container a EVOLUTION_API_KEY e a EVOLUTION_API_URL já
# vêm do .env da raiz via env_file, e `evolution-api:8080` resolve na
# prospere-network. Nada a configurar aqui.
R7_WHATSAPP_ATIVO=1
R7_WHATSAPP_DESTINO=5511963226389
