# Credenciais core pertencem ao Access Guardian; estes valores sao apelidos.
# Cadastre a identidade correspondente no cofre antes de usar este exemplo.
# Robo de REMESSA DE PAGAMENTO (BMP Money Plus) — exemplo de configuracao.
# Copie para config/robo_pagamento.env (que e gitignored) e preencha.
#
#   cp config/robo_pagamento.example.env config/robo_pagamento.env
#   chmod 600 config/robo_pagamento.env

# --- credenciais do Smart -------------------------------------------------- #
# ⭐ E SO ISTO QUE PRECISA MUDAR PARA O ROBO RODAR COM O LOGIN DEFINITIVO.
#
# O usuario precisa alcancar Financeiro > Sistemas de pagamento > Pagamento BMP
# Money Plus > Gerar Remessa, E a conta 404 (mp prospere | 274 | 0001 | 0986952).
# Se nao alcancar, o robo falha NO PING, no comeco, com mensagem clara — e nao
# vira "nada pendente" la na frente (o `URL_PING` aponta para a tela do robo
# justamente para isso).
#
# ATENCAO — JANELA DE HORARIO: o Smart so aceita login dentro do horario de
# acesso cadastrado NO USUARIO. Como este robo roda de 30 em 30 minutos, o cron
# TEM de caber na janela — `*/30 * * * *` faria o dologin.php responder
# "Usuario com acesso restrito." dezenas de vezes por dia, e a falha NAO seria
# do CapSolver. Confira a janela do usuario novo antes de habilitar.
PAGAMENTO_EMAIL=
PAGAMENTO_SENHA=GSMARTPWD2

# --- seguranca ------------------------------------------------------------- #
# DRY_RUN_PAG=True  -> monta o POST, mostra o corpo exato, NAO gera (default)
# DRY_RUN_PAG=false -> GERA DE VERDADE. Remessa de pagamento MOVE DINHEIRO e
#                      nao tem desfazer.
#
# ⛔ NAO BASTA MUDAR ISTO. O wrapper so passa `--pra-valer` se PRA_VALER_PAG
#    estiver definido (veja abaixo) — as duas coisas, de proposito: foi assim
#    que o robo de remessa passou semanas "rodando" sem gerar nada.
DRY_RUN_PAG=True

# Descomente para o wrapper agendado gerar de verdade:
# PRA_VALER_PAG=--pra-valer

# --- escopo (medido em 21/08/2026, contra o Smart real) -------------------- #
# Conta unica do <select> IdContaBancaria: 404 = mp prospere | 274 | 0001 | 0986952
# CONTA_PAG=404
# Status pesquisado. P=Pendente e o que ainda nao virou remessa.
# STATUS_PAG=P

# --- trava de sobreposicao ------------------------------------------------- #
# Cadencia de 30 min: sem trava, uma rodada longa seria morta pela seguinte —
# possivelmente entre o gerar e o gravar, deixando remessa orfa no Smart.
# Rodada em curso -> o wrapper sai com 0 (sobreposicao e normal).
# Rodada presa ha mais de IDADE_ALERTA_MIN_PAG minutos -> sai com 6.
# TRAVA_PAG=/tmp/robo_pagamento.lock
# IDADE_ALERTA_MIN_PAG=45

# --- destino --------------------------------------------------------------- #
# ⚠️ O CAMINHO TEM ESPACOS. Em shell, sempre entre aspas.
# /app/temp e bind-mount de erp-automation/temp/ (./temp:/app/temp no compose) e
# esta no .gitignore, entao remessa nao entra no repo por acidente.
# ⚠️ Pasta LOCAL: nao esta no Nextcloud nem em share Samba — de um Windows
#    ninguem a enxerga. Se o Financeiro precisar ver, o uploader compartilhado e
#    src/common/clients/nextcloud_webdav.py.
# PASTA_SAIDA_PAG=/app/temp/remessas de pagamento
# ARQ_CONTROLE_PAG=/app/data/robo_pagamento/controle_pagamentos.csv

# --- ambiente (so mexa se souber por que) ---------------------------------- #
# USER_DATA_DIR_PAG=/app/data/robo_pagamento/perfil_chrome
# CDP_PORT_PAG=9226   # 9222=boletos, 9223=doc2you, 9224=remessa, 9225=retorno
# DISPLAY_PAG=:94     # :95=retorno, :96=credito, :97=remessa, :98=doc2you, :99=boletos
# HEADLESS_PAG=False  # False: pinta no Xvfb :94 (da p/ ver pelo VNC)
