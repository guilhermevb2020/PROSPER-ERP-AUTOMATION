# Credenciais core pertencem ao Access Guardian; estes valores sao apelidos.
# Cadastre a identidade correspondente no cofre antes de usar este exemplo.
# Ambiente de TESTE dos robos no HOST (scripts/sandbox/) — TEMPLATE.
#
# Copie para config/sandbox.env (fora do git), preencha e proteja:
#     cp config/sandbox.example.env config/sandbox.env
#     chmod 640 config/sandbox.env          # grupo proj-erp-automation le
#     # dono operacional2 (ou o grupo) para o sandbox conseguir ler
#
# `config/*.env` ja e gitignored; este `.example.env` entra sozinho
# (`!config/*.example.*` no .gitignore). NUNCA comite o sandbox.env real.

# --- credencial do Smart usada SO pelo sandbox --------------------------------
# Pode ser a MESMA conta dos robos (prosperito@prospereinvest.com.br) ou, melhor,
# um usuario Smart dedicado a teste — assim a sessao do sandbox nunca disputa
# com a dos robos de producao. O usuario precisa de acesso a
# Financeiro > Imprimir/Enviar boletos.
SANDBOX_EMAIL=
SANDBOX_SENHA=GSMARTPWD3

# --- chave do CapSolver (resolve o reCAPTCHA do login) ------------------------
# A mesma conta CapSolver ja usada pelos robos serve. Sem isto o login para no
# captcha. (Fica so aqui, no arquivo 640 fora do git.)
SANDBOX_CAPSOLVER_API_KEY=__GUARDIAN_SANDBOX_CAPSOLVER_API_KEY__

# --- opcionais (defaults sensatos; descomente para mudar) ---------------------
# Onde o Chrome do sandbox guarda o perfil. NUNCA aponte para
# data/boletos/perfil_chrome (do container) — dois Chromes no mesmo perfil
# travam no lock.
# SANDBOX_PERFIL=/home/prospere/docker/automation/erp-automation/data/sandbox/perfil_chrome

# Onde os PDFs emitidos no sandbox sao salvos (separado da producao).
# SANDBOX_EVIDENCIA_DIR=/home/prospere/docker/automation/erp-automation/data/sandbox/emitidos

# data/ do host que o boletos._config vai usar no lugar de /app/data.
# SANDBOX_DATA_DIR=/home/prospere/docker/automation/erp-automation/data/boletos

# Tela cujo "logado" o sandbox verifica. Default: o PAINEL (smartsecurities.php),
# que responde `expira.php` quando deslogado. NAO aponte para a tela de emissao:
# ela responde 200 com corpo VAZIO deslogada, e o login se auto-aborta.
# SANDBOX_URL_SESSAO=https://wvw.smartsecurities.com.br/smart/smartsecurities.php

# --- display / VNC / gravacao (depuracao visual) ------------------------------
# Por padrao roda HEADLESS e GRAVA video+trace (funciona sem X no host).
# Assista depois com:  .venv-sandbox/bin/playwright show-trace <zip>
# SANDBOX_GRAVAR=true
# SANDBOX_TRACE_DIR=/home/prospere/docker/automation/erp-automation/data/sandbox/trace

# Para ver o navegador AO VIVO por VNC, primeiro (uma vez, com root):
#   sudo apt-get install -y xvfb x11vnc websockify novnc fluxbox
# depois, a cada sessao de trabalho:
#   sh scripts/sandbox/vnc.sh            # sobe Xvfb :90 + VNC 5910 + noVNC 6090
# e ligue estas duas para o Chrome pintar no display:
# SANDBOX_HEADLESS=false
# SANDBOX_DISPLAY=:90

# --- WhatsApp (Evolution API) — usado por scripts/sandbox/finalizar_op.py -----
# A Evolution roda no Docker e, de DENTRO do container, responde em
# `http://evolution-api:8080`. Esse hostname NAO resolve no host — daqui a
# MESMA API responde na 8085 (conferido em 01/09/2026, v2.3.7). Por isso o
# default do sandbox é o endereço de host, e não o do container.
# SANDBOX_EVOLUTION_API_URL=http://127.0.0.1:8085

# Obrigatória para enviar: sem ela a Evolution devolve 401 e o robô avisa que
# não enviou (falha fechado, nunca finge). Está no .env da raiz, que é 600 do
# usuário `prospere` — peça a chave a quem tem acesso.
# SANDBOX_EVOLUTION_API_KEY=

# Só se o nome cadastrado na Evolution diferir do amigável "Prosperito".
# SANDBOX_EVOLUTION_INSTANCIA=Prosperito
