# Perfis do Chrome: cookies de sessao viva do ERP, nunca versionar
data/*/perfil_chrome/

# Boletos emitidos (producao e sandbox): PDF com nome/CNPJ/valor do sacado.
# Evidencia operacional, nunca versionada.
data/boletos/emitidos/
data/sandbox/

# venv do host para rodar o sandbox dos robos (scripts/sandbox/)
.venv-sandbox/

# Guardian é a fonte de credenciais; artefatos locais não são versionáveis.
.env*
!.env.example
*.age
*.pgpass
backups/
.cache/

# 21/09/2026 — organizacao da raiz. Dados de execucao NUNCA entram: perfis de
# Chrome, boletos, prints, CSVs de controle dos robos (881 MB em 4.290 arquivos
# apareciam como "nao rastreados"). Ficam so data/assets/ e os .gitkeep.
data/*
!data/assets/
!data/checkpoints/
!data/processed_outputs/
!data/raw_inputs/
data/checkpoints/*
data/processed_outputs/*
data/raw_inputs/*
!data/checkpoints/.gitkeep
!data/processed_outputs/.gitkeep
!data/raw_inputs/.gitkeep
