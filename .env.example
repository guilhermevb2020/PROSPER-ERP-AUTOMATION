# =============================================================================
# PROSPER-ERP-AUTOMATION - Environment Variables Template
# =============================================================================
# Copie apenas configuracoes nao secretas. Credenciais sao cadastradas no Access Guardian.
# cp .env.example .env

# -----------------------------------------------------------------------------
# CapSolver API (Resolução de CAPTCHA)
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://dashboard.capsolver.com/
CAPSOLVER_API_KEY=__GUARDIAN_CAPSOLVER_API_KEY__

# -----------------------------------------------------------------------------
# SmartSecurities Credentials (DEPRECATED)
# -----------------------------------------------------------------------------
# O Guardian gera .env.guardian. CSVs locais usam apenas apelidos, nunca senhas.
# Estas são mantidas apenas para compatibilidade com código legado
# USUARIO_SITE_SMART=seu@email.com
# SENHA_SITE_SMART=GSMARTPWD1

# -----------------------------------------------------------------------------
# Infraestrutura VNC
# -----------------------------------------------------------------------------
# IP do servidor para acesso VNC
SERVER_IP=127.0.0.1

# Display VNC a ser usado (geralmente :1 ou :2)
DISPLAY=:1

# -----------------------------------------------------------------------------
# Modo Debug
# -----------------------------------------------------------------------------
# true: Mantém browser aberto após execução para inspeção
# false: Fecha browser automaticamente após conclusão (modo produção)
DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Notificações por Email (SMTP)
# -----------------------------------------------------------------------------
# Configurações do servidor SMTP
SMTP_HOST=guardian
SMTP_PORT=2525

# Credenciais do remetente
EMAIL_REMETENTE=notificacoes@exemplo.com
SMTP_PASSWORD=

# Destinatário das notificações
EMAIL_DESTINATARIO=destinatario@exemplo.com

# -----------------------------------------------------------------------------
# Banco de Dados (Azure PostgreSQL)
# -----------------------------------------------------------------------------
# Configurações para conexão com Azure PostgreSQL
DB_HOST=guardian
DB_PORT=5432
DB_NAME=prosperedb
DB_USER=app_erp_automation
DB_PASSWORD=

# Driver SQLAlchemy (opcional, padrão: postgresql+psycopg2)
SQLALCHEMY_DIALECT_DRIVER=postgresql+psycopg2

# -----------------------------------------------------------------------------
# Bright Data (Proxies - Opcional)
# -----------------------------------------------------------------------------
# BrightData retirado da producao. Nova integracao exige cadastro no Guardian.

# -----------------------------------------------------------------------------
# Configurações de Timeout (Opcional)
# -----------------------------------------------------------------------------
# Sobrescreve valores do processors.yaml se definido
# TIMEOUT_CAPTCHA=100
# TIMEOUT_DOWNLOAD=3600
# TIMEOUT_LOGIN=60

# -----------------------------------------------------------------------------
# Configurações de Log (Opcional)
# -----------------------------------------------------------------------------
# Nível de log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Diretórios (Opcional)
# -----------------------------------------------------------------------------
# Sobrescreve diretórios padrão se necessário
# DOWNLOAD_DIR=/home/ubuntu/PROSPER-ERP-AUTOMATION/data/raw_inputs
# SCREENSHOT_DIR=/home/ubuntu/PROSPER-ERP-AUTOMATION/data/screenshots
# LOG_DIR=/home/ubuntu/PROSPER-ERP-AUTOMATION/logs

# -----------------------------------------------------------------------------
# NOTAS IMPORTANTES
# -----------------------------------------------------------------------------
# 1. NUNCA commite o arquivo .env no git
# 2. Use config/credentials.csv para múltiplas credenciais com rotação
# 3. Para Gmail, use "App Password" ao invés da senha normal
# 4. Mantenha suas chaves API seguras
# 5. Execute em modo DEBUG_MODE=false em produção para economizar recursos
